# Standard AI / Scraping Exclusion File
# Excludes sensitive data, credentials, environment variables, keystores, and build artifacts from AI model indexing and contributor tools.

# Environment & Credentials
.env
.env.*
.env*.local
*.env
*.key
*.pem
*.p12
*.p8
*.jks
*.keystore
debug.keystore
google-services.json
credentials.json
service-account*.json
token*.json

# Machine & SDK Configs
android/local.properties
local.properties
.idea/
.vscode/

# Agent Internal Memories & Transcripts
.agents/
.claude/
.junie/
.fallow/
.system_generated/
graphify-out/

# Build & Release Artifacts
apk/
android/app/build/
android/build/
dist/
web-build/
.expo/
.expo-shared/

# Test Reports & Logs
test-results/
playwright-report/
*.log
npm-debug.log*
yarn-debug.log*
expo-e2e.log
